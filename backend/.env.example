# Copy to .env and fill in what you have. Everything is optional —
# without keys the app uses local heuristics and Vosk.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Or a local Ollama server: https://ollama.com  (zero-cost, fully offline)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Overrides
# FFMPEG_BIN=/usr/bin/ffmpeg
# VOSK_MODEL_PATH=/path/to/vosk-model-small-en-us-0.15
# SILENCE_NOISE_DB=-35
# SILENCE_MIN_DUR=0.35
