# Keep the build context small and the image reproducible.
.git
.gitignore
.github
node_modules
**/node_modules

# Python caches / local deps (installed properly inside the image)
__pycache__
**/__pycache__
*.pyc
.venv
venv
backend/vendor

# Runtime data — never bake uploads, renders or the sqlite db into an image
backend/uploads
backend/renders
backend/captions
backend/data
backend/static
backend/.env
*.db
*.db-wal
*.db-shm

# Local / editor noise
*.log
.DS_Store
Thumbs.db
.vscode
.idea
docs
docker-compose.yml
Dockerfile
.dockerignore
