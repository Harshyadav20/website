+    radial-gradient(1200px 600px at 80% -10%, #2a1a5e33, transparent),
+    radial-gradient(900px 500px at -10% 110%, #0e3a3322, transparent),
+    var(--bg);
+  color: var(--text);
+  font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+  min-height: 100vh;
+}
+.app { max-width: 1440px; margin: 0 auto; padding: 0 20px 60px; }
+.muted { color: var(--muted); font-size: 13px; }
+.pad { padding: 18px; }
+h1, h2, h3 { margin: 0; font-weight: 700; letter-spacing: -0.02em; }
+.grad { background: linear-gradient(90deg, var(--accent-2), var(--green)); -webkit-background-clip: text; background-clip: text; color: transparent; }
+
+/* ── topbar ─────────────────────────────────────────────────── */
+.topbar {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: 16px 0; gap: 12px; flex-wrap: wrap;
+}
+.brand {
+  display: flex; align-items: baseline; gap: 10px; background: none; border: none;
+  color: var(--text); font-size: 22px; font-weight: 800; cursor: pointer; letter-spacing: -0.02em;
+}
+.brand-mark { font-size: 26px; }
+.brand-sub { font-size: 12px; font-weight: 500; color: var(--muted); letter-spacing: 0.02em; }
+.engine-badges { display: flex; gap: 8px; flex-wrap: wrap; }
+.badge {
+  font-size: 11px; padding: 4px 10px; border-radius: 999px;
+  background: var(--card-2); border: 1px solid var(--border); color: var(--muted);
+}
+.badge.ok { color: var(--green); border-color: #34d39933; }
+.badge.bad { color: var(--red); border-color: #f8717133; }
+
+/* ── cards / buttons ────────────────────────────────────────── */
+.card {
+  background: var(--card); border: 1px solid var(--border);
+  border-radius: var(--radius); padding: 16px;
+}
+.btn {
+  border: 1px solid var(--border-2); background: var(--card-2); color: var(--text);
+  border-radius: 10px; padding: 10px 16px; font-size: 14px; font-weight: 600;
+  cursor: pointer; transition: 0.15s;
+}
+.btn:hover:not(:disabled) { border-color: var(--accent); }
+.btn:disabled { opacity: 0.45; cursor: not-allowed; }
+.btn.primary { background: linear-gradient(135deg, var(--accent), #6d28d9); border: none; }
+.btn.primary:hover:not(:disabled) { filter: brightness(1.15); }
+.btn.secondary { background: transparent; }
+.btn.ghost { background: transparent; border: none; color: var(--muted); padding: 6px 10px; }
+.btn.ghost:hover { color: var(--text); }
+.btn.tiny { padding: 4px 10px; font-size: 12px; border-radius: 8px; }
+.btn.wide { width: 100%; margin-top: 10px; }
+.icon-btn { background: none; border: none; cursor: pointer; font-size: 15px; opacity: 0.6; }
+.icon-btn:hover { opacity: 1; }
+.chip {
+  font-size: 11px; padding: 3px 9px; border-radius: 999px; white-space: nowrap;
+  background: var(--card-2); border: 1px solid var(--border); color: var(--muted);
+}
+.chip.dur { position: absolute; bottom: 8px; right: 8px; background: #000000aa; color: #fff; }
+.chip.analyzing { color: var(--amber); border-color: #fbbf2433; }
+.chip.done { color: var(--green); border-color: #34d39933; }
