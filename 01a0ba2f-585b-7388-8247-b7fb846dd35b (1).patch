+      </Row>
+
+      <Row label="Whoosh &amp; pop SFX">
+        <button className={`switch ${options.sfx ? 'on' : ''}`}
+                onClick={() => set({ sfx: !options.sfx })}>
+          {options.sfx ? 'ON' : 'OFF'}
+        </button>
