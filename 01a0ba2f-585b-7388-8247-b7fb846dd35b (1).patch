+# Render.com blueprint — one-click deploy for Clipper AI.
+# Deploy from the Render dashboard: New -> Blueprint -> pick your GitHub repo.
+services:
+  - type: web
+    name: clipper-ai
+    runtime: docker
+    plan: starter          # renders need ~2 GB RAM; the free tier is too small
+    healthCheckPath: /api/health
+    disk:                  # keeps uploaded videos + renders across deploys
+      name: clipper-data
+      mountPath: /data
+      sizeGB: 10
+    envVars:
+      - key: DATA_ROOT
+        value: /data
+      - key: WEB_CONCURRENCY
+        value: 1           # video renders are heavy — one worker, not more
diff --git a/scripts/ensure_deps.sh b/scripts/ensure_deps.sh
