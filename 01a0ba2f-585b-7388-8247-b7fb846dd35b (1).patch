+.time { font-size: 12px; color: #ffffffcc; font-variant-numeric: tabular-nums; }
+.player-caption-hint { font-size: 12px; line-height: 1.5; }
+
+.clip-nudge { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); flex-wrap: wrap; }
+.clip-nudge input {
+  width: 76px; background: var(--bg-2); border: 1px solid var(--border); color: var(--text);
