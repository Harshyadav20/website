+.panel-foot { border-top: 1px solid var(--border); margin-top: 12px; padding-top: 10px; font-size: 12px; }
+
+.stages { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; padding: 12px 16px; }
