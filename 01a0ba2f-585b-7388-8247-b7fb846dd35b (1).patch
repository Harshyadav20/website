+.style-tile.active { border-color: var(--accent); color: var(--text); background: #8b5cf617; }
+.style-emoji { font-size: 18px; }
+.style-desc { font-size: 12px; margin: 10px 0 0; line-height: 1.45; }
+
+.ctl-row { margin-bottom: 11px; }
+.ctl-label { font-size: 12.5px; font-weight: 600; margin-bottom: 6px; display: flex; gap: 8px; align-items: baseline; }
+.ctl-hint { color: var(--muted); font-weight: 400; font-size: 11px; }
+.divider { border-top: 1px solid var(--border); margin: 14px 0; }
+
+.seg { display: flex; flex-wrap: wrap; gap: 4px; }
+.seg button {
+  background: var(--bg-2); border: 1px solid var(--border); color: var(--muted);
+  padding: 5px 11px; font-size: 12px; border-radius: 8px; cursor: pointer;
+}
+.seg button.active { border-color: var(--accent); color: var(--text); background: #8b5cf61a; }
+.switch {
+  background: var(--bg-2); border: 1px solid var(--border); color: var(--muted);
+  padding: 5px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer;
+}
+.switch.on { border-color: var(--green); color: var(--green); background: #34d39914; }
+input[type="range"] { width: 100%; accent-color: var(--accent); }
+.text-input, select {
+  width: 100%; background: var(--bg-2); border: 1px solid var(--border); color: var(--text);
+  border-radius: 8px; padding: 8px 10px; font-size: 13px;
+}
+select { cursor: pointer; }
+
+/* render */
+.render-row { display: flex; flex-direction: column; gap: 10px; }
+.res-seg { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
+.res-seg button { padding: 7px; font-size: 12.5px; }
+.render-job { margin-top: 12px; }
+.render-job.done .render-msg { color: var(--green); }
+.render-job.error .render-msg { color: var(--red); }
+.render-preview {
+  width: 200px; display: block; margin: 12px auto 0; border-radius: 10px;
+  border: 1px solid var(--border); background: #000;
+}
+.render-actions { text-align: center; margin-top: 10px; }
+.render-history { margin-top: 16px; border-top: 1px solid var(--border); padding-top: 10px; }
+.render-item { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 12.5px; }
+.render-name { flex: 1; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); flex-shrink: 0; }
+.status-dot.done { background: var(--green); }
+.status-dot.error { background: var(--red); }
+.status-dot.running, .status-dot.queued { background: var(--amber); animation: pulse 1.2s infinite; }
+@keyframes pulse { 50% { opacity: 0.4; } }
+
+/* transcript */
+.transcript { margin-top: 14px; }
+.transcript-body { max-height: 220px; overflow-y: auto; line-height: 2; font-size: 13.5px; }
+.tseg { cursor: pointer; color: var(--muted); padding: 2px 4px; border-radius: 6px; }
+.tseg:hover { color: var(--text); background: #ffffff0a; }
+.tseg.inclip { color: var(--text); background: #34d39914; }
+.tseg-time { font-size: 11px; color: var(--accent-2); font-variant-numeric: tabular-nums; }
+
+/* scrollbars */
+::-webkit-scrollbar { width: 9px; height: 9px; }
+::-webkit-scrollbar-thumb { background: #ffffff1c; border-radius: 99px; }
+::-webkit-scrollbar-track { background: transparent; }
+
+/* responsive */
+@media (max-width: 1150px) {
+  .editor-grid { grid-template-columns: 300px 1fr; }
+  .props { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
+}
+@media (max-width: 860px) {
+  .hero-cols { grid-template-columns: 1fr; }
+  .editor-grid { grid-template-columns: 1fr; }
+  .hero h1 { font-size: 30px; }
+}
+
+/* live detail under the active analysis stage */
+.stage-detail {
+  margin-top: .25rem;
+  margin-left: 1.6rem;
+  font-size: .72rem;
+  color: var(--muted, #9aa3b2);
+  animation: pulse-soft 2s ease-in-out infinite;
+}
+@keyframes pulse-soft {
+  0%, 100% { opacity: .55; }
+  50% { opacity: 1; }
+}
+
+/* ── V6 multi-track timeline editor ─────────────────────────────────── */
+.tled { margin-top: .8rem; padding: .55rem .65rem .5rem; }
+.tled-bar { display: flex; align-items: center; gap: .4rem; margin-bottom: .45rem; flex-wrap: wrap; }
+.tled-bar b { font-size: .82rem; }
+.tled-spacer { flex: 1; }
+.tled-scroll { overflow-x: auto; padding-bottom: .3rem; cursor: crosshair; }
+.tled-inner { position: relative; }
+.tled-ruler { position: relative; height: 20px; border-bottom: 1px solid var(--line, #23263a); margin-left: 92px; }
+.tled-tick { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line, #2a2d44); }
+.tled-tick span { position: absolute; top: 1px; left: 4px; font-size: .6rem; color: var(--muted, #9aa3b2); white-space: nowrap; }
+.tled-row { display: flex; align-items: stretch; height: 34px; margin-top: 3px; }
+.tled-gutter { width: 92px; flex: 0 0 92px; font-size: .68rem; color: var(--muted, #9aa3b2);
+  display: flex; align-items: center; padding-left: .2rem; user-select: none; }
+.tled-lane { position: relative; flex: 1; background: rgba(255,255,255,.03);
+  border-radius: 6px; min-width: 168px; }
+.tled-blk { position: absolute; top: 3px; bottom: 3px; border-radius: 5px; opacity: .92;
+  display: flex; align-items: center; overflow: hidden; cursor: grab; user-select: none;
+  box-shadow: 0 1px 4px rgba(0,0,0,.35); touch-action: none; }
+.tled-blk.sel { outline: 2px solid #fff; opacity: 1; z-index: 3; }
+.tled-blk.video { color: #06122b; }
+.tled-blk.text { color: #241f00; }
+.tled-blk.fx { color: #17061f; }
+.tled-blk.audio { color: #00210f; }
+.tled-blk-label { font-size: .62rem; font-weight: 700; padding: 0 8px; white-space: nowrap;
+  overflow: hidden; text-overflow: ellipsis; pointer-events: none; }
+.tled-edge { position: absolute; top: 0; bottom: 0; width: 7px; cursor: ew-resize;
+  background: rgba(0,0,0,.28); touch-action: none; }
+.tled-edge.l { left: 0; border-radius: 5px 0 0 5px; }
+.tled-edge.r { right: 0; border-radius: 0 5px 5px 0; }
+.tled-playhead { position: absolute; top: 0; bottom: 0; width: 2px; background: #ff4757;
+  margin-left: 92px; z-index: 5; pointer-events: none; box-shadow: 0 0 6px #ff4757aa; }
+.tled-inspect { display: flex; align-items: center; gap: .5rem; margin-top: .5rem;
+  flex-wrap: wrap; font-size: .72rem; min-height: 30px; padding-top: .35rem;
+  border-top: 1px solid var(--line, #23263a); }
+.tled-inspect input[type="number"] { width: 62px; }
+.tled-inspect .text-input { width: 190px; }
+.tled-inspect label { display: flex; align-items: center; gap: .3rem; color: var(--muted, #9aa3b2); }
+.tled-inspect select { padding: .18rem .3rem; }
+.btn.danger { color: #ff6b6b; border-color: #ff6b6b44; }
